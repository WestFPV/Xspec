RESEND_API_KEY=re_your_server_key_here
AUTH_FROM_EMAIL="Xspec <login@your-verified-domain.com>"
AUTH_CODE_SECRET=replace_with_a_long_random_secret
AUTH_APP_NAME=Xspec
PORT=5173
