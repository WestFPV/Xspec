COOKIE_SECURE=false
# Leave the start time blank to keep Tournament mode locked.
# Set a future ISO-8601 timestamp (for example 2026-12-12T18:00:00Z) to schedule an event.
XSPEC_TOURNAMENT_TITLE=XSPEC Neon Cup
XSPEC_TOURNAMENT_STARTS_AT=
